# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git에 올리지 않는다(.gitignore).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=400
# 서비스 계정 JSON 전체를 한 줄 문자열로(Render 환경 변수 권장) 또는 파일 경로
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
ALLOWED_ORIGINS=http://localhost:5500,https://mateai-web-jk4v-two.vercel.app,https://trymateai.com
SEED_ON_EMPTY=1
